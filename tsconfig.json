{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "noEmit": true,
        "strict": true,
        "esModuleInterop": true,
        "verbatimModuleSyntax": true,
        "lib": ["ES2022"],
        "types": ["node"],
        "newLine": "lf"
    },
    "include": ["src/**/*", "test/**/*.ts", "tsdown.config.ts"],
    "exclude": ["dist"]
}
